.code-intel/
*.db
*.sqlite
*.sqlite3

# Generated browser UI. Build it with: cd web && pnpm build:webui
/src/code_intel/webui/*
!/src/code_intel/webui/.gitkeep

# Environment / secrets
.env
.env.*
!.env.example

